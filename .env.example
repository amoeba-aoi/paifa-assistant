# 发货方昵称（无密码；也可用中文名「发货方」登录）
SHIPPER_NICKNAME=shipper
SHIPPER_CN=发货方

# 会话签名（生产环境请更换为随机长字符串）
SESSION_SECRET=paifa-local-dev-secret-change-me

# --- 远程多用户存储（Vercel 等无持久磁盘的环境必填）---
# 创建一个含 store.json 的 GitHub Gist，然后填入：
# STORE_GIST_ID=xxxxxxxx
# STORE_GITHUB_TOKEN=ghp_xxx   # 需要 gist 权限；也可用 GITHUB_TOKEN / GH_TOKEN
# 本地开发可不填，默认使用 data/store.json
